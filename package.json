{
  "name": "gsap-react-marquee",
  "author": "David Domenico Piscopo",
  "description": "A high-performance React marquee component powered by GSAP",
  "license": "MIT",
  "version": "0.4.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/index.cjs",
    "dist/index.esm.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --project=chromium",
    "test:browser:webkit": "playwright test --project=webkit",
    "test:package": "pnpm run build && node tests/package/run-smoke.mjs && node tests/package/packed-smoke.mjs && node tests/package/bundle-smoke.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "audit": "pnpm audit --audit-level=moderate",
    "release:check": "pnpm run check && pnpm run test:browser && pnpm run test:browser:webkit && pnpm run test:package && pnpm run audit && git diff --check",
    "prepare": "npm run build"
  },
  "keywords": [
    "react",
    "marquee",
    "gsap",
    "animation",
    "scroll",
    "infinite",
    "component",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daviddpi/gsap-react-marquee.git"
  },
  "bugs": {
    "url": "https://github.com/daviddpi/gsap-react-marquee/issues"
  },
  "homepage": "https://gsap-react-marquee-docs.vercel.app/",
  "peerDependencies": {
    "@gsap/react": "^2.1.1",
    "gsap": "^3.12.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gsap/react": "^2.1.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  }
}
