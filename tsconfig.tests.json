{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "global.d.ts",
    "playwright.config.ts",
    "tests/browser/**/*.ts",
    "tests/browser/**/*.tsx",
    "tests/setup.ts",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules", "tests/package"]
}
